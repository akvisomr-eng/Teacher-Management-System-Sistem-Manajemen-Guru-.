# Neon Postgres (server-only, use the least-privilege tms_app role)
DATABASE_URL=

# Neon Managed Auth (branch-specific URL)
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Teaching Assistant — keep unset until provider/model and budget are approved. Server-only.\nAI_GATEWAY_API_KEY=\nTMS_AI_MODEL=\n\n# Midtrans — keep disabled until merchant onboarding and sandbox acceptance are complete.
# Server Key is server-only. Never use a NEXT_PUBLIC_ prefix for it.
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
# Publishable Snap Client Key; add only when the checkout UI is implemented.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=