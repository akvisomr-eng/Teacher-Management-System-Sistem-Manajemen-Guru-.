# Neon Postgres (server-only, use the least-privilege tms_app role)
DATABASE_URL=

# Neon Managed Auth (branch-specific URL)
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Teaching Assistant — explicit kill switch stays false until spend/model approval.
TMS_AI_ENABLED=false
TMS_AI_BUDGET_APPROVED=false
# TMS_AI_MODEL must be a verified provider/model ID. Server-only.
# Vercel injects VERCEL_OIDC_TOKEN automatically; use AI_GATEWAY_API_KEY only outside Vercel.
AI_GATEWAY_API_KEY=
TMS_AI_MODEL=

# Midtrans — keep disabled until merchant onboarding and sandbox acceptance are complete.
# Server Key is server-only. Never use a NEXT_PUBLIC_ prefix for it.
MIDTRANS_ENABLED=false
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
# Publishable Snap Client Key; add only when the checkout UI is implemented.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=